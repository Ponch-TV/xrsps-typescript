# Server-side deploy config. Copy to `.env.deploy` on the host and fill in.
#   docker compose --env-file .env.deploy up -d --build
#
# `.env*` is gitignored (except this example) — keep the real file off GitHub.

# Hostname pointed at this box with an A record. Caddy gets a Let's Encrypt
# certificate for it on first request, so it must resolve publicly before you
# start the stack.
GAME_DOMAIN=game.example.com

# Where Let's Encrypt sends expiry warnings. Optional but recommended.
TLS_EMAIL=you@example.com

# Which gamemode the server runs: `vanilla` or `leagues-v`.
GAMEMODE=vanilla

# Shown on the client's login screen and server list.
SERVER_NAME=xRSPS

# Set to false once your characters exist, so nobody else can claim usernames.
ALLOW_ACCOUNT_REGISTRATION=true

# debug | info | warn | error
LOG_LEVEL=info
