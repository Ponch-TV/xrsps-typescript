# TLS front door. See docker-compose.yml.
#
# Everything the browser needs lives behind one hostname and one certificate:
#
#   /              the static client, and the WebSocket game protocol
#   /caches/*      the OSRS cache download
#   /status        player count, polled by the login screen's server list
#
# The game protocol and the client's index.html share the `/` path, so they are
# told apart by the Upgrade header rather than by URL.

{
	email {$TLS_EMAIL}
}

{$GAME_DOMAIN} {
	# Skip the cache: it is already-compressed binary, so re-encoding ~200MB per
	# new player costs CPU and saves nothing.
	@compressible not path /caches/*
	encode @compressible zstd gzip

	@websocket header Connection *Upgrade*
	handle @websocket {
		reverse_proxy game:43594 {
			# A tick is 600ms and an idle player can send nothing for minutes.
			# Without this the proxy drops healthy game connections.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /caches/* {
		reverse_proxy game:43594
	}

	handle /status {
		reverse_proxy game:43594
	}

	# Single-page app: unknown paths resolve to index.html so client routing works.
	handle {
		root * /srv/client
		try_files {path} /index.html
		file_server
	}
}
